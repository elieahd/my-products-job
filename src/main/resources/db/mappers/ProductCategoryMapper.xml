<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.myp.jobs.infrastructure.outbound.database.mappers.ProductCategoryMapper">

    <resultMap id="productCategoryResultMap" type="com.myp.jobs.domain.models.ProductCategory">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="description" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="findByCode" resultMap="productCategoryResultMap">
        SELECT id, code, description
        FROM product_category
        WHERE code = #{code}
    </select>

</mapper>
